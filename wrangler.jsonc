{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nexoratechnologies",
  "main": "./src/cloudflare-worker.js",
  "compatibility_date": "2026-09-06",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "MAX_JSON_BYTES": "262144",
    "INQUIRY_RATE_LIMIT": "5",
    "INQUIRY_RATE_WINDOW_SECONDS": "3600",
    "ADMIN_SESSION_TIMEOUT_SECONDS": "28800",
    "ADMIN_LOGIN_RATE_LIMIT": "8",
    "ADMIN_LOGIN_RATE_WINDOW_SECONDS": "900",
    "PROJECT_FILE_MAX_BYTES": "26214400",
    "PROJECT_FILE_MAX_ATTACHMENTS": "8"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexora-db",
      "database_id": "71c3bf88-b71d-465b-9032-5251a11fde64"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECT_REALTIME",
        "class_name": "ProjectRealtimeRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "nx-collab-1",
      "new_sqlite_classes": [
        "ProjectRealtimeRoom"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROJECT_FILES",
      "bucket_name": "nexora-project-files"
    }
  ]
}
